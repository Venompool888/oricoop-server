# Optional: copy to /etc/oricoop-cserver.env for systemd, or use Docker --env-file.
ORICOOP_CSERVER_PORT=47022
# Optional connection audit log (IP, SteamID and nickname). Default: false.
#ORICOOP_CSERVER_LOG_CONNECTIONS=true
# systemd supplies LOGS_DIRECTORY automatically. Docker requires a writable mount.
#ORICOOP_CSERVER_LOG_DIR=/var/log/oricoop-cserver

# Optional join diagnostics behind a TLS proxy (README, Optional environment reports).
# Set both PORT and DIR. DIR must already exist and be writable by the service user.
#ORICOOP_DIAGNOSTICS_PORT=47023
#ORICOOP_DIAGNOSTICS_DIR=/var/log/oricoop-cserver
#ORICOOP_DIAGNOSTICS_DAYS=7
